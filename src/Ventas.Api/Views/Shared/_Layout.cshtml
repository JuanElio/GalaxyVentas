@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @* Token antifalsificación para las llamadas jQuery por POST (site.js lo envía en la cabecera) *@
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken">
    <title>@ViewData["Title"] - GalaxyVentas</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <header class="barra">
        <a class="marca" asp-controller="Home" asp-action="Index">GalaxyVentas</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav>
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <a asp-controller="Ventas" asp-action="Registrar">Registrar venta</a>
            </nav>
            <div class="sesion">
                <span>@User.FindFirst(ClaimsSesion.Nombre)?.Value · Punto de venta @User.FindFirst(ClaimsSesion.PuntoVenta)?.Value</span>
                <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                    <button class="btn btn-sec btn-sm" type="submit">Cerrar sesión</button>
                </form>
            </div>
        }
    </header>

    <main class="contenedor">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
